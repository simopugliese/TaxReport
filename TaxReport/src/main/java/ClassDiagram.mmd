classDiagram
    direction TB

%% --- CORE BUSINESS LOGIC ---
    class ExpenseCoreService {
        -StorageStrategy storage
        -MetadataRepository repository
        -RuleEngine rules
        +createExpense(NewExpenseDTO) UUID
        +uploadDocument(UUID, DocType, InputStream)
    }

%% --- ABSTRACTIONS (INTERFACES) ---
    class StorageStrategy {
        <<Interface>>
        +createDirectory(String path)
        +saveStream(String path, String name, InputStream stream)
        +exists(String path)
    }

    class MetadataRepository {
        <<Interface>>
        +save(ExpenseEntry)
        +findById(UUID) ExpenseEntry
        +updateStatus(UUID, ValidationStatus)
    }

%% --- CONCRETE IMPLEMENTATIONS (PLUGINS) ---
    class LocalStorageStrategy {
        +createDirectory(path)
        +saveStream(path, name, stream)
    }

    class RemoteStorageStrategy {
        -String sshHost
        +createDirectory(path)
        +saveStream(path, name, stream)
    }

    class SqlMetadataRepository {
        -Connection dbConnection
        +save(entry)
    }

    class JsonMetadataRepository {
        -File jsonDbFile
        +save(entry)
    }

%% --- DOMAIN ENTITIES ---
    class ExpenseEntry {
        +UUID id
        +String relativePath
        +ValidationStatus status
        +Map~DocType, DocumentSlot~ slots
    }

%% --- RELATIONSHIPS ---
    ExpenseCoreService --> StorageStrategy : uses
    ExpenseCoreService --> MetadataRepository : uses

    LocalStorageStrategy ..|> StorageStrategy : implements
    RemoteStorageStrategy ..|> StorageStrategy : implements

    SqlMetadataRepository ..|> MetadataRepository : implements
    JsonMetadataRepository ..|> MetadataRepository : implements

    ExpenseCoreService ..> ExpenseEntry : manages