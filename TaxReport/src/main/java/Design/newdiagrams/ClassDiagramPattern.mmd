classDiagram
    direction TB

%% --- 1. STRATEGY PATTERN (Infrastruttura) ---
%% Permette di scambiare FileSystem con S3 o SQL con JSON a runtime
    namespace Strategy_Pattern {
        class StorageService { <<Interface>> }
        class FileSystemStorage
        class S3Storage
    }
    FileSystemStorage ..|> StorageService : Strategy A
    S3Storage ..|> StorageService : Strategy B

%% --- 2. STATE PATTERN (Dominio) ---
%% Gestisce il comportamento (Upload/Lock) senza if/else
    namespace State_Pattern {
        class ExpenseEntry { +changeState(State) }
        class ExpenseState { <<Interface>> }
        class OpenState
        class LockedState
    }
    ExpenseEntry o-- ExpenseState : Context
    OpenState ..|> ExpenseState : Concrete State
    LockedState ..|> ExpenseState : Concrete State

%% --- 3. CHAIN OF RESPONSIBILITY (Validazione) ---
%% Disaccoppia le regole di validazione in classi piccole e sequenziali
    namespace Chain_Pattern {
        class RuleEngine
        class RuleValidator { <<Interface>> +validate(next) }
        class MandatoryDocsRule
        class NamingConventionRule
    }
    RuleEngine o-- RuleValidator : Builds Chain
    MandatoryDocsRule ..|> RuleValidator
    NamingConventionRule ..|> RuleValidator

%% --- 4. DATA TRANSFER OBJECT (Disaccoppiamento) ---
%% Isola il Dominio dalla Persistenza
    namespace DTO_Pattern {
        class ExpenseEntry_Domain
        class ExpenseStateDTO_Record
        class MetadataRepository
    }
    ExpenseEntry_Domain ..> ExpenseStateDTO_Record : Maps to
    MetadataRepository ..> ExpenseStateDTO_Record : Persists

%% --- 5. FACTORY / PROVIDER (Wiring) ---
%% Nasconde le implementazioni concrete (Incapsulamento)
    namespace Factory_Pattern {
        class ServiceLoader
        class StorageProvider { <<Interface>> create() }
        class FileSystemProvider
    }
    ServiceLoader ..> StorageProvider : Loads
    FileSystemProvider ..|> StorageProvider : Creates Concrete