flowchart LR
%% --- Definizioni Stili ---
    classDef dto fill:#e1f5fe,stroke:#01579b,stroke-width:1px;
    classDef domain fill:#fff3e0,stroke:#e65100,stroke-width:2px;
    classDef db fill:#f3e5f5,stroke:#4a148c,stroke-width:1px;
    classDef mapper fill:#f5f5f5,stroke:#666,stroke-dasharray: 5 5;

%% --- Sottogruppi ---
    subgraph External ["Mondo Esterno (Input)"]
        direction TB
        InDTO(NewExpenseDTO)
    end

    subgraph Core ["Dominio (Business Logic)"]
        direction TB
        Mapper1((Map In))
        Entity[ExpenseEntry<br/>Domain Object]
        Mapper2((Map Out))
    end

    subgraph Infra ["Persistenza (Output)"]
        direction TB
        StateDTO(ExpenseStateDTO)
        DB[(Database / File)]
    end

%% --- Flusso ---
    InDTO --> Mapper1
    Mapper1 -->|To Domain| Entity

    Entity -->|Business Logic| Entity

    Entity --> Mapper2
    Mapper2 -->|To Snapshot| StateDTO
    StateDTO -->|Save| DB

%% --- Applicazione Classi ---
    class InDTO,StateDTO dto;
    class Entity domain;
    class DB db;
    class Mapper1,Mapper2 mapper;