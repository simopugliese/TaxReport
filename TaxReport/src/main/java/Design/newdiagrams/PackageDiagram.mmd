flowchart TD
%% --- Definizione dei Moduli (Package) ---

    subgraph API ["com.taxreport.api (Il Contratto)"]
        direction TB
        d1[DTOs]
        d2[Exceptions]
        d3[Service Interfaces]
        d4[SPI Providers]
    end

    subgraph Core ["com.taxreport.core (Il Dominio)"]
        direction TB
        c1[Domain Model]
        c2[Rule Engine]
        c3[State Machine]
        c4[Command Handlers]
    end

    subgraph Infra ["com.taxreport.infra (I Plugin)"]
        direction TB
        i1[FileSystem Storage]
        i2[SQL Repository]
        i3[JSON Repository]
    end

    subgraph App ["com.taxreport.app (Main)"]
        direction TB
        a1[Main Wiring]
        a2[ServiceLoader Config]
    end

%% --- Relazioni tra Package ---

%% Il Core usa l'API (Interfacce e DTO)
    Core -->|uses| API

%% L'Infra implementa l'API (SPI)
    Infra -.->|implements| API

%% L'App assembla tutto
    App -->|assembles| Core
    App -->|loads via SPI| Infra
    App -->|depends| API

%% Stile (Opzionale per renderlo più leggibile)
    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px;
    classDef contract fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef domain fill:#fff3e0,stroke:#e65100,stroke-width:2px;

    class API contract;
    class Core domain;